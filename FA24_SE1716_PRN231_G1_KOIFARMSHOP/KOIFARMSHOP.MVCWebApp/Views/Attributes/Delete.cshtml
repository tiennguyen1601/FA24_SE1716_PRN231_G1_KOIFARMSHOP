@model KOIFARMSHOP.Data.Models.Attribute
@{
    ViewData["Title"] = "Delete Attribute";
}

<h1 class="text-center my-4">Delete Attribute</h1>
<p>Are you sure you want to delete this attribute?</p>

<div class="card p-4 shadow-sm">
    <dl class="row">
        <dt class="col-sm-4">Attribute Name</dt>
        <dd class="col-sm-8">@Model.AttributeName</dd>

        <dt class="col-sm-4">Display Name</dt>
        <dd class="col-sm-8">@Model.DisplayName</dd>

    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="AttributeId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
